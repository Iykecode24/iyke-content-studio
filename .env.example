# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/iyke_studio

# Redis / Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# LLM APIs
OPENAI_API_KEY=sk-...
OPEN_SOURCE_LLM_URL=http://localhost:8080/v1

# Providers
RUNPOD_API_KEY=rpa_...
ELEVENLABS_API_KEY=...

# Storage (S3 / R2 / GCS)
STORAGE_PROVIDER=r2
STORAGE_ACCOUNT_ID=...
STORAGE_ACCESS_KEY=...
STORAGE_SECRET_KEY=...
STORAGE_BUCKET=iyke-content-studio

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=placeholder_token_here

# Cloudflare R2
R2_ACCOUNT_ID=placeholder_r2_account_id
R2_ACCESS_KEY_ID=placeholder_r2_access_key
R2_SECRET_ACCESS_KEY=placeholder_r2_secret_key
R2_BUCKET_NAME=iykestudio-production

# Google Drive
GOOGLE_DRIVE_CREDENTIALS_JSON={}
GOOGLE_DRIVE_FOLDER_ID=placeholder_folder_id
